<Application x:Class="LinBench.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LinBench.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colours.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <!-- NEW: look of the original LinBench window (top bar, nav, chip strip, sidebar, status bar) -->
                <ResourceDictionary Source="Themes/Shell.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- NEW: converters used by SetupView / ProgressView / MainWindow -->
            <conv:StringEqualsConverter x:Key="StringEquals" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
            <conv:BoolToStableBrushConverter x:Key="BoolToStableBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
