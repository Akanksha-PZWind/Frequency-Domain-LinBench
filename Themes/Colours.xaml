<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Palette (Matching LinBench's clean TuneMe design language) -->
    <Color x:Key="ColorPrimary">#2A78D6</Color>
    <Color x:Key="ColorPrimaryHover">#1E64B8</Color>
    <Color x:Key="ColorPrimaryActive">#18549C</Color>
    <Color x:Key="ColorPrimarySubtle">#EBF3FC</Color>

    <Color x:Key="ColorBg">#F5F7FA</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceHover">#F8FAFC</Color>
    <Color x:Key="ColorSurfaceSelected">#EBF3FC</Color>

    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderStrong">#CBD5E1</Color>

    <Color x:Key="ColorText">#1E293B</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextSubtle">#94A3B8</Color>
    <Color x:Key="ColorTextOnPrimary">#FFFFFF</Color>

    <!-- Status Colors -->
    <Color x:Key="ColorGood">#16A34A</Color>
    <Color x:Key="ColorGoodBg">#DCFCE7</Color>
    <Color x:Key="ColorWarn">#D97706</Color>
    <Color x:Key="ColorWarnBg">#FEF3C7</Color>
    <Color x:Key="ColorCrit">#DC2626</Color>
    <Color x:Key="ColorCritBg">#FEE2E2</Color>

    <!-- Plot Colors (MATLAB / LinBench Series Order) -->
    <Color x:Key="ColorSeries1">#0072BD</Color>
    <Color x:Key="ColorSeries2">#D95319</Color>
    <Color x:Key="ColorSeries3">#EDB120</Color>
    <Color x:Key="ColorSeries4">#7E2F8E</Color>
    <Color x:Key="ColorSeries5">#77AC30</Color>
    <Color x:Key="ColorSeries6">#4DBEEE</Color>
    <Color x:Key="ColorSeries7">#A2142F</Color>
    <Color x:Key="ColorSeries8">#4D4D4D</Color>

    <!-- Plot Area Tokens -->
    <Color x:Key="ColorPlotBg">#FFFFFF</Color>
    <Color x:Key="ColorPlotFrame">#1E293B</Color>
    <Color x:Key="ColorPlotGrid">#E2E8F0</Color>
    <Color x:Key="ColorPlotGridFine">#F1F5F9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryActive" Color="{StaticResource ColorPrimaryActive}" />
    <SolidColorBrush x:Key="BrushPrimarySubtle" Color="{StaticResource ColorPrimarySubtle}" />

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceSelected" Color="{StaticResource ColorSurfaceSelected}" />

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />

    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextSubtle" Color="{StaticResource ColorTextSubtle}" />
    <SolidColorBrush x:Key="BrushTextOnPrimary" Color="{StaticResource ColorTextOnPrimary}" />

    <SolidColorBrush x:Key="BrushGood" Color="{StaticResource ColorGood}" />
    <SolidColorBrush x:Key="BrushGoodBg" Color="{StaticResource ColorGoodBg}" />
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}" />
    <SolidColorBrush x:Key="BrushWarnBg" Color="{StaticResource ColorWarnBg}" />
    <SolidColorBrush x:Key="BrushCrit" Color="{StaticResource ColorCrit}" />
    <SolidColorBrush x:Key="BrushCritBg" Color="{StaticResource ColorCritBg}" />

    <SolidColorBrush x:Key="BrushSeries1" Color="{StaticResource ColorSeries1}" />
    <SolidColorBrush x:Key="BrushSeries2" Color="{StaticResource ColorSeries2}" />
    <SolidColorBrush x:Key="BrushSeries3" Color="{StaticResource ColorSeries3}" />
    <SolidColorBrush x:Key="BrushSeries4" Color="{StaticResource ColorSeries4}" />
    <SolidColorBrush x:Key="BrushSeries5" Color="{StaticResource ColorSeries5}" />
    <SolidColorBrush x:Key="BrushSeries6" Color="{StaticResource ColorSeries6}" />
    <SolidColorBrush x:Key="BrushSeries7" Color="{StaticResource ColorSeries7}" />
    <SolidColorBrush x:Key="BrushSeries8" Color="{StaticResource ColorSeries8}" />

    <SolidColorBrush x:Key="BrushPlotBg" Color="{StaticResource ColorPlotBg}" />
    <SolidColorBrush x:Key="BrushPlotFrame" Color="{StaticResource ColorPlotFrame}" />
    <SolidColorBrush x:Key="BrushPlotGrid" Color="{StaticResource ColorPlotGrid}" />
    <SolidColorBrush x:Key="BrushPlotGridFine" Color="{StaticResource ColorPlotGridFine}" />

</ResourceDictionary>
