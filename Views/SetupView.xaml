<UserControl x:Class="LinBench.Wpf.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1500">
    <!-- Same layout as the original LinBench start page: Inputs | Operating points found, then Recent. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ShellBg}">
        <StackPanel Margin="24,18,24,24" MaxWidth="1480">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.87*" MinWidth="460" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- ================= Inputs ================= -->
                <Border Grid.Column="0" Style="{StaticResource ShellCard}">
                    <StackPanel>
                        <TextBlock Text="Inputs" Style="{StaticResource ShellCardTitle}" />

                        <!-- linearisation folder -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Linearisation folder" Style="{StaticResource ShellLabel}" />
                            <TextBlock Text="required" Style="{StaticResource ShellHint}" />
                        </StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource ShellButton}"
                                    Margin="6,0,0,0" Click="OnBrowseLinDirClick" />
                            <TextBox Style="{StaticResource ShellInput}" Tag="Folder containing OpenFAST .lin files"
                                     Text="{Binding LinearisationDir, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox Content="include sub-folders" IsChecked="{Binding Recursive}" Style="{StaticResource ShellCheckBox}"
                                  Margin="3,9,0,16" />

                        <!-- analysis -->
                        <TextBlock Text="Analysis" Style="{StaticResource ShellLabel}" Margin="0,0,0,4" />
                        <TextBlock Text="Open loop: operating points and Campbell diagram" Style="{StaticResource ShellHint}" Margin="0,0,0,4" />
                        <CheckBox Content="Remove rotor-azimuth state (as ROSCO does)" IsChecked="{Binding RemoveAzimuth}"
                                  Style="{StaticResource ShellCheckBox}" Margin="3,10,0,0" />

                        <!-- run -->
                        <Button Content="Run analysis" Style="{StaticResource ShellPrimaryButton}" Command="{Binding RunAnalysisCommand}"
                                HorizontalAlignment="Right" Margin="0,40,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================= Operating points found ================= -->
                <Border Grid.Column="2" Style="{StaticResource ShellCard}">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanMeta}" Foreground="{StaticResource ShellMuted}"
                                       FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock Text="Operating points found" Style="{StaticResource ShellCardTitle}" Margin="0" />
                        </DockPanel>

                        <!-- auto-detected files / warnings and the status line under the table -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding DetectedMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource ShellMuted}" FontSize="12.5"
                                                   Margin="0,2" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid>
                            <!-- nothing scanned yet: centred message, like the original -->
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ShellMuted}" FontSize="13.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="460">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OperatingGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OperatingGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource ShellMuted}"
                                           FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding OperatingGroups}" AutoGenerateColumns="False" IsReadOnly="True"
                                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                                            BorderThickness="0" Background="White" RowBackground="White"
                                            HorizontalGridLinesBrush="{StaticResource ShellLine}" MaxHeight="420"
                                            LoadingRow="DataGrid_LoadingRow">

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="10,0,10,0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sr. no" Binding="{Binding Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="60" />
                                        <DataGridTextColumn Header="Wind [m/s]" Binding="{Binding WindSpeed, StringFormat={}{0:0.##}}" Width="90" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="60" />
                                        <DataGridTextColumn Header="Rotor Ω [rpm]" Binding="{Binding RotorRpm, StringFormat={}{0:0.###}}" Width="110" />
                                        <DataGridTextColumn Header="Ω spread [%]" Binding="{Binding OmegaCheck.SpreadPct, StringFormat={}{0:0.###}}" Width="100" />
                                        <!--<DataGridTextColumn Header="Status" Binding="{Binding WarningText}" Width="*" />-->
                                        <!--<DataGridTextColumn Header="Status" Binding="{Binding Files[0]}" Width="*" />-->
                                        <!--<DataGridTextColumn Header="Status" Binding="{Binding Files[0], StringFormat={}{0}\, {1}\, ...}" Width="*" />-->

                                        <DataGridTemplateColumn Header="First Files" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}, {1}, ...">
                                                                <Binding Path="Files[0] " />
                                                                <Binding Path="Files[1] " />
                                                                <!--<Binding Path="Files[2]" />-->
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= Recent ================= -->
            <Border Style="{StaticResource ShellCard}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Recent" Style="{StaticResource ShellCardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource ShellLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Use" Style="{StaticResource ShellSmallButton}"
                                                Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding LinDir}" FontFamily="{StaticResource ShellMono}" FontSize="12.5"
                                                   Foreground="#3A3F47" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LinDir}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No recent analyses yet." Foreground="{StaticResource ShellMuted}" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentFolders.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
