<UserControl x:Class="LinBench.Wpf.Views.Panels.StabilitySummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Border Style="{StaticResource CardStyle}" Margin="16">
        <DockPanel LastChildFill="True">
            <TextBlock Text="Closed-Loop Stability &amp; Margins" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Top" />
            <TextBlock Text="Stability margins evaluated for the ROSCO controller closed around the OpenFAST linear model at each wind speed."
                       Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" DockPanel.Dock="Top" />

            <DataGrid ItemsSource="{Binding ClosedRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Wind [m/s]" Binding="{Binding WindSpeed, StringFormat={}{0:0.#}}" Width="95" />
                    <DataGridTextColumn Header="Region" Binding="{Binding RegionName}" Width="170" />
                    <DataGridTextColumn Header="Gain Margin [dB]" Binding="{Binding GainMarginDb, StringFormat={}{0:0.0}}" Width="130" />
                    <DataGridTextColumn Header="Phase Margin [deg]" Binding="{Binding PhaseMarginDeg, StringFormat={}{0:0.0}}" Width="140" />
                    <DataGridTextColumn Header="Delay Margin [s]" Binding="{Binding DelayMarginS, StringFormat={}{0:0.00}}" Width="125" />
                    <DataGridTextColumn Header="Disk GM [dB]" Binding="{Binding DiskGainMarginDb, StringFormat={}{0:0.0}}" Width="105" />
                    <DataGridTextColumn Header="Min ζ [%]" Binding="{Binding MinZeta, StringFormat={}{0:0.00%}}" Width="85" />
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{Binding Stable, Converter={StaticResource BoolToStableBrush}}">
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
