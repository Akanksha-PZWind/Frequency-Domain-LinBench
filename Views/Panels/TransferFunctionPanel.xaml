<UserControl x:Class="LinBench.Wpf.Views.Panels.TransferFunctionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1100" d:DesignWidth="1200">
    <!-- Transfer function page as in the original LinBench (app.js 'ol:tf'):
         Bode diagram (magnitude + phase, log frequency axis) · Pole-zero map (poles ×, zeros ○, cancelled poles faded).
         Input / Output and Quick pick are in the right sidebar ▾ VIEW SETTINGS, G(s) and the verdict under ▾ INSIGHTS,
         the numbers of both cards under ▾ RESULTS. -->
    <UserControl.Resources>
        <Style x:Key="TfCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,14,18,10" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="TfTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="TfSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ShellBg}">
        <StackPanel Margin="20,16,20,16">

            <TextBlock x:Name="TxtError" FontSize="13.5" Foreground="#C81E1E" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <!-- Bode diagram -->
            <Border Style="{StaticResource TfCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Bode diagram" Style="{StaticResource TfTitle}" />
                        <TextBlock x:Name="TxtBodeSub" Text="open loop" Style="{StaticResource TfSub}" />
                        <TextBlock x:Name="TxtBusy" Text="  · loading…" Style="{StaticResource TfSub}" Foreground="{StaticResource BrushPrimary}"
                                   Visibility="Collapsed" />
                    </WrapPanel>
                    <controls:LbChart x:Name="ChartMag" Height="260" ChartTitle="Bode magnitude" />
                    <controls:LbChart x:Name="ChartPhase" Height="230" ChartTitle="Bode phase" />
                </StackPanel>
            </Border>

            <!-- Pole-zero map -->
            <Border Style="{StaticResource TfCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <CheckBox x:Name="CbCancelled" DockPanel.Dock="Right" Style="{StaticResource ShellCheckBox}" VerticalAlignment="Bottom"
                                  Margin="12,0,0,1" Checked="OnCancelledChanged" Unchecked="OnCancelledChanged">
                            <TextBlock Text="show cancelled poles" FontSize="13" Foreground="{StaticResource BrushText}" />
                        </CheckBox>
                        <WrapPanel>
                            <TextBlock Text="Pole-zero map" Style="{StaticResource TfTitle}" />
                            <TextBlock Text="poles ×, zeros ○ · faded: pole cancelled by a zero (mode not excited or not observed)"
                                       Style="{StaticResource TfSub}" />
                        </WrapPanel>
                    </DockPanel>
                    <controls:LbChart x:Name="ChartPz" Height="420" ChartTitle="Pole-zero map" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
