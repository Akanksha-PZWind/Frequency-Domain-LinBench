<UserControl x:Class="LinBench.Wpf.Views.Panels.CampbellPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="2100" d:DesignWidth="1200">
    <!-- Campbell page as in the original LinBench (app.js 'ol:campbell'):         
         Campbell diagram · Campbell visualization diagram · Damping of the tracked modes · Tracked modes table.         
         Its controls (Frequency, Max frequency, aero/hydro states) are in the right sidebar ▾ VIEW SETTINGS,         
         its numbers (tracked modes, lowest mode, closest to 1P/3P/6P, symmetry legend) under ▾ RESULTS. -->
    <UserControl.Resources>
        <Style x:Key="CbCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,14,18,10" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="CbTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="CbSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ShellBg}">
        <StackPanel Margin="20,16,20,16">

            <TextBlock x:Name="TxtEmpty" Text="No oscillatory structural modes found." FontSize="14"
                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />

            <!-- Campbell diagram -->
            <Border x:Name="CardFreq" Style="{StaticResource CbCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock x:Name="TxtFreqTitle" Text="Campbell diagram" Style="{StaticResource CbTitle}" />
                        <TextBlock x:Name="TxtFreqSub" Text="natural frequency of each tracked mode · line/marker style = symmetry" Style="{StaticResource CbSub}" />
                        <TextBlock x:Name="TxtBusy" Text="  · updating…" Style="{StaticResource CbSub}" Foreground="{StaticResource BrushPrimary}" Visibility="Collapsed" />
                    </WrapPanel>
                    <controls:LbChart x:Name="ChartFreq" Height="580" ChartTitle="Campbell diagram" />
                </StackPanel>
            </Border>

            <!-- Campbell Visualization Diagram: mode-shape animation of the point clicked in the Campbell diagram
                 (frames from the backend /api/mode_shape, drawn by controls:TurbineView) -->
            <Border x:Name="CardViz" Style="{StaticResource CbCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock x:Name="TxtVizTitle" Text="Campbell visualization diagram" Style="{StaticResource CbTitle}" />
                        <TextBlock x:Name="TxtVizSub" Text="click a point in the Campbell diagram (or a row of Tracked modes) to animate that mode at that wind speed"
                                   Style="{StaticResource CbSub}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtVizBusy" Text="  · loading…" Style="{StaticResource CbSub}" Foreground="{StaticResource BrushPrimary}" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock x:Name="TxtVizError" Foreground="#C81E1E" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <controls:TurbineView x:Name="Turbine" Grid.Column="0" Height="620" />

                        <!-- animation controls -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Animation" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="BtnPlay" Content="Pause" Style="{StaticResource ShellSmallButton}" Width="80" Click="OnPlayClick" Margin="0,0,8,0" />
                                <CheckBox x:Name="CbRef" Content="undeformed" Style="{StaticResource ShellCheckBox}" IsChecked="True"
                                          Checked="OnRefChanged" Unchecked="OnRefChanged" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="View" FontSize="13" FontWeight="Medium" Margin="0,0,0,6" />
                            <Border Style="{StaticResource ShellSegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="3D" Tag="3d" GroupName="VizView" Style="{StaticResource ShellMiniSegment}" IsChecked="True" Checked="OnViewChecked" />
                                    <RadioButton Content="Front" Tag="front" GroupName="VizView" Style="{StaticResource ShellMiniSegment}" Checked="OnViewChecked" />
                                    <RadioButton Content="Side" Tag="side" GroupName="VizView" Style="{StaticResource ShellMiniSegment}" Checked="OnViewChecked" />
                                    <RadioButton Content="Top" Tag="top" GroupName="VizView" Style="{StaticResource ShellMiniSegment}" BorderThickness="0" Checked="OnViewChecked" />
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock x:Name="TxtScale" DockPanel.Dock="Right" Text="0.15" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="Deflection (largest / length)" FontSize="13" FontWeight="Medium" />
                            </DockPanel>
                            <Slider x:Name="SldScale" Minimum="0.02" Maximum="0.5" Value="0.15" SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="OnScaleChanged" PreviewMouseUp="OnScaleCommitted" KeyUp="OnScaleKeyUp" Margin="0,0,0,10" />

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock x:Name="TxtSpeed" DockPanel.Dock="Right" Text="1×" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="Speed" FontSize="13" FontWeight="Medium" />
                            </DockPanel>
                            <Slider x:Name="SldSpeed" Minimum="0.1" Maximum="3" Value="1" SmallChange="0.1" LargeChange="0.5"
                                    ValueChanged="OnSpeedChanged" Margin="0,0,0,12" />

                            <TextBlock Text="Turbine size [m]" FontSize="13" FontWeight="Medium" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tower" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBox x:Name="TbTower" Style="{StaticResource ShellInput}" Tag="auto" FontSize="12.5" KeyDown="OnSizeKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Blade" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBox x:Name="TbBlade" Style="{StaticResource ShellInput}" Tag="auto" FontSize="12.5" KeyDown="OnSizeKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Hub r" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBox x:Name="TbHub" Style="{StaticResource ShellInput}" Tag="auto" FontSize="12.5" KeyDown="OnSizeKeyDown" />
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource ShellSmallButton}" Click="OnApplySize" />
                                <TextBlock x:Name="TxtSizeSource" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>

                            <TextBlock Text="Moving DOFs" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <ItemsControl x:Name="DofList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1,0,3" ToolTip="{Binding Tip}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0" />
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="5" CornerRadius="2" Background="#E6E9EE" />
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="5" CornerRadius="2" Background="#0072BD"
                                                    HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Amplitude relative to the largest DOF and phase. Cosine and sine blade components 90° apart = whirl." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Damping -->
            <Border x:Name="CardDamp" Style="{StaticResource CbCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Damping of the tracked modes" Style="{StaticResource CbTitle}" />
                        <TextBlock Text="damping ratio vs wind speed" Style="{StaticResource CbSub}" />
                    </WrapPanel>
                    <controls:LbChart x:Name="ChartDamp" Height="420" ChartTitle="Damping of the tracked modes" />
                </StackPanel>
            </Border>

            <!-- Tracked modes -->
            <Border x:Name="CardTable" Style="{StaticResource CbCard}">
                <StackPanel>
                    <TextBlock Text="Tracked modes" Style="{StaticResource CbTitle}" Margin="0,0,0,12" />
                    <DataGrid x:Name="ModesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" MaxHeight="620"
                              PreviewMouseWheel="OnGridPreviewMouseWheel" SelectionMode="Single"
                              SelectionChanged="OnModesGridSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="3*" />
                            <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*" />
                            <DataGridTextColumn Header="Symmetry" Binding="{Binding Symmetry}" Width="1.6*" />
                            <DataGridTextColumn Header="f min [Hz]" Binding="{Binding FMin}" ElementStyle="{StaticResource NumCell}" Width="*" />
                            <DataGridTextColumn Header="f max [Hz]" Binding="{Binding FMax}" ElementStyle="{StaticResource NumCell}" Width="*" />
                            <DataGridTextColumn Header="ζ min [%]" Binding="{Binding ZetaMin}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Unstable}" Value="True">
                                                <Setter Property="Foreground" Value="#C81E1E" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="at [m/s]" Binding="{Binding At}" ElementStyle="{StaticResource NumCell}" Width="0.8*" />
                            <DataGridTextColumn Header="Points" Binding="{Binding Points}" ElementStyle="{StaticResource NumCell}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>