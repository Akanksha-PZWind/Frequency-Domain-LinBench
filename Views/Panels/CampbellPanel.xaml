<UserControl x:Class="LinBench.Wpf.Views.Panels.CampbellPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1300" d:DesignWidth="1200">
    <!-- Campbell page as in the original LinBench (app.js 'ol:campbell'):
         Campbell diagram · Damping of the tracked modes · Tracked modes table.
         Its controls (Loop, Frequency, Max frequency, aero/hydro states) are in the right sidebar ▾ VIEW SETTINGS,
         its numbers (tracked modes, lowest mode, closest to 1P/3P/6P, symmetry legend) under ▾ RESULTS. -->
    <UserControl.Resources>
        <Style x:Key="CbCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,14,18,10" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="CbTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="CbSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ShellBg}">
        <StackPanel Margin="20,16,20,16">

            <TextBlock x:Name="TxtEmpty" Text="No oscillatory structural modes found." FontSize="14"
                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />

            <!-- Campbell diagram -->
            <Border x:Name="CardFreq" Style="{StaticResource CbCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock x:Name="TxtFreqTitle" Text="Campbell diagram" Style="{StaticResource CbTitle}" />
                        <TextBlock x:Name="TxtFreqSub" Text="natural frequency of each tracked mode · line/marker style = symmetry" Style="{StaticResource CbSub}" />
                        <TextBlock x:Name="TxtBusy" Text="  · updating…" Style="{StaticResource CbSub}" Foreground="{StaticResource BrushPrimary}" Visibility="Collapsed" />
                    </WrapPanel>
                    <controls:LbChart x:Name="ChartFreq" Height="580" ChartTitle="Campbell diagram" />
                </StackPanel>
            </Border>

            <!-- Damping -->
            <Border x:Name="CardDamp" Style="{StaticResource CbCard}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Damping of the tracked modes" Style="{StaticResource CbTitle}" />
                        <TextBlock Text="damping ratio vs wind speed" Style="{StaticResource CbSub}" />
                    </WrapPanel>
                    <controls:LbChart x:Name="ChartDamp" Height="420" ChartTitle="Damping of the tracked modes" />
                </StackPanel>
            </Border>

            <!-- Tracked modes -->
            <Border x:Name="CardTable" Style="{StaticResource CbCard}">
                <StackPanel>
                    <TextBlock Text="Tracked modes" Style="{StaticResource CbTitle}" Margin="0,0,0,12" />
                    <DataGrid x:Name="ModesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" MaxHeight="620"
                              PreviewMouseWheel="OnGridPreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="3*" />
                            <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*" />
                            <DataGridTextColumn Header="Symmetry" Binding="{Binding Symmetry}" Width="1.6*" />
                            <DataGridTextColumn Header="f min [Hz]" Binding="{Binding FMin}" ElementStyle="{StaticResource NumCell}" Width="*" />
                            <DataGridTextColumn Header="f max [Hz]" Binding="{Binding FMax}" ElementStyle="{StaticResource NumCell}" Width="*" />
                            <DataGridTextColumn Header="ζ min [%]" Binding="{Binding ZetaMin}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Unstable}" Value="True">
                                                <Setter Property="Foreground" Value="#C81E1E" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="at [m/s]" Binding="{Binding At}" ElementStyle="{StaticResource NumCell}" Width="0.8*" />
                            <DataGridTextColumn Header="Points" Binding="{Binding Points}" ElementStyle="{StaticResource NumCell}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
