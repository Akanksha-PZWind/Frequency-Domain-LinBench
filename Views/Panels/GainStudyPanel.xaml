<UserControl x:Class="LinBench.Wpf.Views.Panels.GainStudyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Border Style="{StaticResource CardStyle}" Margin="16">
        <DockPanel LastChildFill="True">
            <TextBlock Text="PI Gain Study &amp; Stability Map" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Top" />
            <TextBlock Text="Variation of closed-loop damping ratio ζ across proportional gain factor f_Kp and integral gain factor f_Ki."
                       Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" DockPanel.Dock="Top" />

            <!-- Gain Map 2D Visualizer / Info Box -->
            <Border Background="{StaticResource BrushSurfaceHover}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Base Gains vs Trial Point" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <DockPanel Margin="0,4">
                        <TextBlock Text="Base Kp factor:" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding MapResult.BaseFx, StringFormat={}{0:0.00}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="Base Ki factor:" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding MapResult.BaseFy, StringFormat={}{0:0.00}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="Grid Resolution:" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="25 x 25 Points (0.25x - 4.00x)" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>

                    <Separator Margin="0,12" Background="{StaticResource BrushBorder}" />
                    <TextBlock Text="Click any point on the gain grid to compare loop shape, margins, poles, and step responses against baseline DISCON controller parameters."
                               Foreground="{StaticResource BrushTextMuted}" LineHeight="18" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
