<UserControl x:Class="LinBench.Wpf.Views.Panels.TimeResponsePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Controls Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Input:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}"
                          DisplayMemberPath="Name" Width="180" Margin="0,0,16,0" />

                <TextBlock Text="Output:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                          DisplayMemberPath="Name" Width="180" Margin="0,0,16,0" />

                <TextBlock Text="Signal:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag" Width="100" Margin="0,0,16,0">
                    <ComboBoxItem Content="Step" Tag="step" IsSelected="True" />
                    <ComboBoxItem Content="Impulse" Tag="impulse" />
                </ComboBox>

                <TextBlock Text="Duration [s]:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0" />

                <TextBlock Text="Amp:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Amplitude, UpdateSourceTrigger=PropertyChanged}" Width="60" />
            </WrapPanel>
        </Border>

        <!-- Time Response Plot -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <controls:WpfPlotView x:Name="PlotTime" Title="Open-Loop Time Response"
                                  XAxisLabel="Time [s]" YAxisLabel="Response" />
        </Border>
    </Grid>
</UserControl>
