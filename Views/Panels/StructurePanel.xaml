<UserControl x:Class="LinBench.Wpf.Views.Panels.StructurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Kalman Ranks & Uncontrollable Modes -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Controllability &amp; Observability" Style="{StaticResource CardHeaderStyle}" />
                <TextBlock Text="Orthogonal staircase (Kalman decomposition) and PBH modal measures."
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" FontSize="12" />

                <!-- Ranks -->
                <Border Background="{StaticResource BrushSurfaceHover}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="{Binding Result.TotalStates}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            <TextBlock Text="Total System States:" Foreground="{StaticResource BrushTextMuted}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="{Binding Result.ControllableRank}" FontWeight="SemiBold" DockPanel.Dock="Right" Foreground="{StaticResource BrushGood}" />
                            <TextBlock Text="Controllable Rank:" Foreground="{StaticResource BrushTextMuted}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="{Binding Result.ObservableRank}" FontWeight="SemiBold" DockPanel.Dock="Right" Foreground="{StaticResource BrushGood}" />
                            <TextBlock Text="Observable Rank:" Foreground="{StaticResource BrushTextMuted}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Uncontrollable Modes -->
                <TextBlock Text="Uncontrollable Modes" FontWeight="SemiBold" Margin="0,4,0,4" />
                <ListBox ItemsSource="{Binding Result.UncontrollableModes}" Height="120" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" />

                <!-- Unobservable Modes -->
                <TextBlock Text="Unobservable Modes" FontWeight="SemiBold" Margin="0,4,0,4" />
                <ListBox ItemsSource="{Binding Result.UnobservableModes}" Height="120" BorderBrush="{StaticResource BrushBorder}" />
            </StackPanel>
        </Border>

        <!-- Right: Hankel Singular Values Plot -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8">
            <controls:WpfPlotView x:Name="PlotHsv" Title="Hankel Singular Values (Stable Subsystem)"
                                  XAxisLabel="State Index" YAxisLabel="Singular Value σ_i" IsYLog="True" />
        </Border>
    </Grid>
</UserControl>
