<UserControl x:Class="LinBench.Wpf.Views.Panels.NyquistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12,10">
            <DockPanel LastChildFill="True">
                <Border Background="{StaticResource BrushSurfaceHover}" CornerRadius="4" Padding="10,4" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nyquist Winding Number: " Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding Detail.Nyquist.WindingNumber, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Nyquist Diagram &amp; Critical Point (-1, 0)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Plot -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <controls:WpfPlotView x:Name="PlotNyquist" Title="Nyquist Plot of L(jω)"
                                  XAxisLabel="Real Part" YAxisLabel="Imaginary Part" />
        </Border>
    </Grid>
</UserControl>
