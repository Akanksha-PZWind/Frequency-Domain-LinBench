<UserControl x:Class="LinBench.Wpf.Views.Panels.LoopShapePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LinBench.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Metrics Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border Background="{StaticResource BrushSurfaceHover}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Peak Sensitivity Ms: " Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding Detail.LoopShape.Ms, StringFormat={}{0:0.00}}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrushSurfaceHover}" CornerRadius="4" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Peak Complementary Mt: " Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding Detail.LoopShape.Mt, StringFormat={}{0:0.00}}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Loop Shape L(s), Sensitivity S(s), &amp; Complementary Sensitivity T(s)"
                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Plot -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <controls:WpfPlotView x:Name="PlotLoop" Title="Loop Shape Magnitudes"
                                  XAxisLabel="Frequency [rad/s]" YAxisLabel="Magnitude [dB]" IsXLog="True" />
        </Border>
    </Grid>
</UserControl>
