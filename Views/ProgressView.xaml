<UserControl x:Class="LinBench.Wpf.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100">
            <!-- 2-Column Grid: Progress & Physics explanation -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="450" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="350" />
                </Grid.ColumnDefinitions>

                <!-- Left: Progress card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ElapsedFormatted}" DockPanel.Dock="Right"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Analysing" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                        </DockPanel>

                        <!-- Progress Bar -->
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                     Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,10" />

                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" DockPanel.Dock="Right"
                                       FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushPrimary}" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextMuted}"
                                       TextTrimming="CharacterEllipsis" FontSize="13" />
                        </DockPanel>

                        <!-- Error Message if any -->
                        <Border Background="{StaticResource BrushCritBg}" BorderBrush="{StaticResource BrushCrit}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushCrit}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Back to inputs" Style="{StaticResource StandardButton}"
                                    Command="{Binding BackCommand}" Margin="0,0,12,0" />
                            <Button Content="Open results" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenResultsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Physics / Maths explanation -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="What is being computed" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="{Binding MathExplanation}" Foreground="{StaticResource BrushText}"
                                   TextWrapping="Wrap" LineHeight="20" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Analysis Live Log Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Analysis Log" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Top" />
                    <ScrollViewer Height="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat={}{0:0.0}s}"
                                                   Foreground="{StaticResource BrushTextSubtle}" FontFamily="Consolas, monospace" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stage}"
                                                   Foreground="{StaticResource BrushPrimary}" FontWeight="Medium" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                   Foreground="{StaticResource BrushText}" TextWrapping="Wrap" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
