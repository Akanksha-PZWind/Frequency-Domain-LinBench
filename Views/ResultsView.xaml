<UserControl x:Class="LinBench.Wpf.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource ShellBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== wind-speed strip (as in the original): label · ‹ chips › · ROTOR / PITCH / GEN TORQUE ===== -->
        <Border Grid.Row="0" Background="#FAFAF8" BorderBrush="{StaticResource ShellCardBorder}" BorderThickness="0,0,0,1"
                Padding="20,8,20,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="WIND SPEED [M/S]" Style="{StaticResource ShellSectionHeader}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button DockPanel.Dock="Left" Content="‹" Style="{StaticResource ShellChevron}" Command="{Binding PreviousOpCommand}"
                            ToolTip="Previous wind speed (←)" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="›" Style="{StaticResource ShellChevron}" Command="{Binding NextOpCommand}"
                            ToolTip="Next wind speed (→)" Margin="8,0,0,0" />
                    <ListBox ItemsSource="{Binding OperatingPoints}" SelectedIndex="{Binding SelectedOpIndex, Mode=TwoWay}"
                             Style="{StaticResource ShellChipStrip}" ItemContainerStyle="{StaticResource ShellChip}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WindSpeed, StringFormat={}{0:0.##}}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="ROTOR" Style="{StaticResource ShellSectionHeader}" FontSize="11" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CtxRotor}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" rpm" FontSize="12" Foreground="{StaticResource ShellMuted}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="PITCH" Style="{StaticResource ShellSectionHeader}" FontSize="11" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CtxPitch}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" °" FontSize="12" Foreground="{StaticResource ShellMuted}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="GEN TORQUE" Style="{StaticResource ShellSectionHeader}" FontSize="11" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CtxTorque}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" MN·m" FontSize="12" Foreground="{StaticResource ShellMuted}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Panel Host -->
        <ContentControl Grid.Row="1" x:Name="PanelHost" />
    </Grid>
</UserControl>
